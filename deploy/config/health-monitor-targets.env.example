# Non-secret external health targets for Internal Health Monitor.
# Install (manual): copy to /etc/online-zapis-tv/health-monitor-targets.env
#   sudo install -o root -g deploy -m 0640 \
#     deploy/config/health-monitor-targets.env.example \
#     /etc/online-zapis-tv/health-monitor-targets.env
# Then edit URLs for the active n8n contour (TEST/DEV today; future PROD self-hosted).
#
# Rules:
# - HTTPS only
# - No credentials, tokens, or secrets in URLs (no userinfo)
# - No query strings or fragments
# - If this file is absent (or all IHM_N8N_* keys absent), n8n probing is disabled
#   and does NOT make Internal Health Monitor unhealthy.
#
# Same monitor can represent:
# - current TEST/DEV n8n (operator fills the cloud HTTPS base)
# - future PROD self-hosted tv_n8n (operator swaps host/paths only)

# Short stable identifier used in evidence/alerts (not a hostname).
IHM_N8N_TARGET_ID=n8n-test-dev

# Absolute HTTPS health URLs — path must be exactly /healthz or /healthz/readiness
# (no trailing slash, no query, no fragment, no credentials).
IHM_N8N_LIVENESS_URL=https://n8n-test.example.invalid/healthz
IHM_N8N_READINESS_URL=https://n8n-test.example.invalid/healthz/readiness

# Bounded connect/request timeout in seconds (default 10, allowed 1..60).
IHM_N8N_TIMEOUT_SEC=10

# Consecutive probe failures before durable critical escalation (default 2, allowed 1..10).
# A single transient transport failure below this threshold does not raise critical.
IHM_N8N_FAILURE_THRESHOLD=2
