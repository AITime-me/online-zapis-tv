# PostgreSQL (локально через Docker; позже — Timeweb PostgreSQL 17)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tvoe_vremya

# Часовой пояс студии (Курган, UTC+5). В БД — UTC; в UI — время студии.
APP_TIMEZONE=Asia/Yekaterinburg

# Аварийная выгрузка (локально)
EXPORT_STORAGE=local
EXPORT_LOCAL_DIR=./exports/emergency

# Позже: S3 / Timeweb Object Storage
# S3_BUCKET=
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Авторизация (Auth.js / NextAuth)
AUTH_SECRET=dev-secret-change-in-production
AUTH_URL=http://localhost:3000

# Общая read-only ссылка для мастеров (/view/schedule?token=...)
SCHEDULE_VIEW_TOKEN=change-me-in-production

# Debug-плашка на /schedule (по умолчанию выключена)
# NEXT_PUBLIC_SCHEDULE_DEBUG=true

# Публичные онлайн-слоты: post-filter цепочек достижимости (по умолчанию выкл.)
# ONLINE_BOOKING_SLOT_CHAINS_ENABLED=true
# APPOINTMENT_FULL_BUSY_END_WRITES_ENABLED=true

# Шаг позже: API для AI-бота (без персональных данных)
# BOT_API_KEY=

# S2S Bearer for /api/internal/bot/v1/* (server-only; min 32 printable ASCII).
# Optional in local/CI env schema; unset/short → internal routes fail-closed 401.
# Separate value per environment. Never use NEXT_PUBLIC_*. Do not commit real values.
# Compose maps BOT_INTERNAL_API_TOKEN into the app container at runtime only.
BOT_INTERNAL_API_TOKEN=

# Required for POST /api/internal/bot/v1/bookings idempotency fingerprints (CURSOR-24).
# Dedicated secret only — never reuse AUTH_SECRET / NEXTAUTH_SECRET / BOT_INTERNAL_API_TOKEN.
# Min 32 UTF-8 bytes. Empty/whitespace/placeholders → fail-closed INTERNAL_ERROR (no booking).
# BOT_INTERNAL_IDEMPOTENCY_HMAC_SECRET=
# Optional comma-separated previous secrets for rotation-safe replay (each ≥32 bytes, max 8).
# BOT_INTERNAL_IDEMPOTENCY_HMAC_PREVIOUS_SECRETS=

# Уведомления владельцу о «Проблема на сайте» (опционально; отдельный бот, не Тех-сторож)
# PROBLEM_REPORT_TELEGRAM_BOT_TOKEN=
# PROBLEM_REPORT_TELEGRAM_CHAT_ID=
